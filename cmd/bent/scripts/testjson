#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--timeout" ]]; then
  if [[ "$#" -lt 3 ]]; then
    echo "usage: testjson --timeout DURATION TEST_BINARY [ARG ...]" >&2
    exit 2
  fi
  duration=$2
  shift 2
  if ! command -v timeout >/dev/null 2>&1; then
    echo "timeout is required by the testjson watchdog" >&2
    exit 1
  fi
  exec timeout --signal=TERM --kill-after=30s "$duration" \
    go tool test2json -p "${BENT_BENCH:-unknown}" "$@"
fi

exec go tool test2json -p "${BENT_BENCH:-unknown}" "$@"
